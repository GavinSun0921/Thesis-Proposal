# 学校原始模板、参考稿与临时检查文件仅在本地保留。
/材料/
/tmp/
/.mimocode/

# 编译结果和中间文件统一放入 latex/build；当前阅读版及命名版本 PDF 入库。
/latex/build/*
!/latex/build/main.pdf
!/latex/build/main-*.pdf
/latex/main.pdf
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.bcf
*.run.xml
*.synctex
*.synctex.gz
*.fdb_latexmk
*.fls
*.xdv
*.dvi

# 素材处理脚本的 Python 缓存。
__pycache__/
*.py[cod]

# 系统元数据和编辑器临时文件。
.DS_Store
._*
*.swp
*.swo
*~
