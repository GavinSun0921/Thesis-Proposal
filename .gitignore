# 学校原始模板、参考稿与临时检查文件仅在本地保留。
/材料/
/tmp/
/.mimocode/
/.dsh-office.*/

# 文献统计的抓取缓存、逐条大表与过程预览只在本地生成，不纳入仓库。
/docs/literature_stats/raw/
/docs/literature_stats/official_titles.json
/docs/literature_stats/excluded.csv
/docs/revision-assets/

# 隔离的版面审计构建仅供本地检查。
/latex/.audit-build.*/

# 正式发布版放入 output；候选 PDF 和图件预览不入库。
/output/*.rc*.pdf
/latex/figures/chapters/**/preview*.png

# 编译结果和中间文件统一放入 latex/build；仅当前阅读版入库。
/latex/build/*
!/latex/build/main.pdf
/latex/main.pdf
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.bcf
*.run.xml
*.synctex
*.synctex.gz
*.fdb_latexmk
*.fls
*.xdv
*.dvi

# 素材处理脚本的 Python 缓存。
__pycache__/
*.py[cod]

# 系统元数据和编辑器临时文件。
.DS_Store
._*
*.swp
*.swo
*~
